# Необязательные стартовые данные. При первом запуске мастер настройки
# предложит создать администратора и заполнить S3/SMTP.
ADMIN_USER=admin
ADMIN_PASSWORD=replace-with-a-long-password
SESSION_TTL_HOURS=12
# Включите после настройки HTTPS reverse proxy
COOKIE_SECURE=false

# Случайная строка длиной 32+ символа. Не меняйте после добавления роутеров.
MASTER_KEY=replace-with-a-random-secret-at-least-32-characters

# S3 / MinIO / Selectel / Yandex Object Storage и другие S3-совместимые сервисы
S3_ENDPOINT=https://s3.example.com
S3_REGION=us-east-1
S3_BUCKET=mikrotik-backups
S3_ACCESS_KEY=replace-me
S3_SECRET_KEY=replace-me
S3_ADDRESSING_STYLE=path
S3_SSE=AES256

# Ежедневное расписание по часовому поясу контейнера
TZ=Asia/Novosibirsk
BACKUP_HOUR=3
BACKUP_MINUTE=0
DATABASE_PATH=/data/routervault.db
BACKUP_WORKERS=4
